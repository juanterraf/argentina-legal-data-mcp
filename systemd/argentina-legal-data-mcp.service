[Unit]
Description=Argentina Legal & Data MCP (streamable-http, 127.0.0.1:8090 behind nginx)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=argmcp
Group=argmcp
WorkingDirectory=/opt/argentina-legal-data-mcp
# Same .env the app reads (ARGMCP_TRANSPORT/HOST/PORT/AUTH_ENABLED/DATA_DIR/CACHE_DIR/
# DATASET_PATH/USER_AGENT). Production: 127.0.0.1:8090, auth off, data in
# /opt/argentina-legal-data-mcp/data and cache in /opt/argentina-legal-data-mcp/.cache.
EnvironmentFile=-/opt/argentina-legal-data-mcp/.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/argentina-legal-data-mcp/.venv/bin/python -m arg_legal_mcp serve --transport streamable-http
Restart=on-failure
RestartSec=3
UMask=0027

# ── Hardening ──────────────────────────────────────────────────────────────────
# The only writable paths are the data dir (dataset, health.sqlite, build lock/temp) and
# the cache dir. IF YOU CHANGE ARGMCP_DATA_DIR / ARGMCP_CACHE_DIR / ARGMCP_DATASET_PATH in
# .env, change ReadWritePaths here AND in argentina-legal-data-mcp-dataset.service.
ReadWritePaths=/opt/argentina-legal-data-mcp/data /opt/argentina-legal-data-mcp/.cache
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
RemoveIPC=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
# MemoryDenyWriteExecute is intentionally NOT set: libffi/cffi-based wheels can need
# W+X pages and would crash at runtime.
LimitNOFILE=4096
TasksMax=256

[Install]
WantedBy=multi-user.target
